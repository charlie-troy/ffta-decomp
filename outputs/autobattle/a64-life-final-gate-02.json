  "full_policy": {
    "schema": "ffta-tactics-policy/2",
    "fallback": "wait",
    "observation": {
      "max_age_seconds": 3.0
    },
    "assignments": {
      "party": {
        "player": {
          "rules": [
            {
              "id": "revive-before-attack",
              "enabled": true,
              "select": "first",
              "when": {
                "kind": "ability",
                "ability_name": "Life",
                "relation": "ally",
                "target_hp": {
                  "eq": 0
                },
                "remaining_mp_after_cost": {
                  "gte": 8
                }
              },
              "note": "a KO'd ally is exactly HP 0; the absolute predicate is used because a percent floors a 1-HP high-max ally to 0 too"
            },
            {
              "id": "heal-wounded-ally",
              "enabled": true,
              "select": "lowest-target-hp",
              "when": {
                "kind": "ability",
                "ability_name": "Cure",
                "relation": "ally",
                "target_hp": {
                  "gt": 0
                },
                "target_hp_pct": {
                  "lte": 50
                },
                "remaining_mp_after_cost": {
                  "gte": 8
                }
              },
              "note": "heal the weakest wounded ally; the MP predicate is the reserve that keeps at least 8 MP after the cast"
            },
            {
              "id": "heal-self",
              "enabled": true,
              "select": "first",
              "when": {
                "kind": "ability",
                "ability_name": "Cure",
                "relation": "self",
                "target_hp": {
                  "gt": 0
                },
                "actor_hp_pct": {
                  "lte": 40
                },
                "remaining_mp_after_cost": {
                  "gte": 8
                }
              },
              "note": "self-heal below 40% while still holding the MP reserve"
            },
            {
              "id": "pressure-enemy",
              "enabled": true,
              "select": "lowest-target-hp",
              "when": {
                "relation": "enemy"
              },
              "note": "otherwise take the engine-offered action on the weakest enemy"
            },
            {
              "id": "use-potion-last-resort",
              "enabled": false,
              "select": "first",
              "when": {
                "kind": "item",
                "item_name": "Potion",
                "item_count": {
                  "gte": 1
                }
              },
              "note": "never-use-item by default: consumables are disabled, so this rule stays disabled and the party consumes nothing"
            }
          ],
          "note": "Healer preset for every player-side actor without its own character assignment. Ordered revive -> heal ally -> heal self -> attack; every choice still comes only from the engine-legal candidates the adapter supplies."
        }
      }
    },
    "consumables": false,
    "note": "A6 resource/recovery preset. Consumables stay disabled (no `consumables` flag), so the item rule cannot fire; the MP reserve is the remaining_mp_after_cost predicate. A learned heal is never a candidate by itself -- the engine must offer it."
  },
