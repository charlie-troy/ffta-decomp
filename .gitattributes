# The toolchain runs under WSL. CRLF line endings break shell scripts there,
# so keep everything LF regardless of the checkout platform.
* text=auto eol=lf
*.sh text eol=lf
*.gba binary
*.bin binary
# Captured A6.1 JSON receipts carry SHA256 hashes of their exact original bytes.
outputs/autobattle/a61-*/**/*.json -text whitespace=cr-at-eol
